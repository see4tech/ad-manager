# ─── OpenRouter ────────────────────────────────────────────────
# Solo se usa la API. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelos (los slugs cambian; ver https://openrouter.ai/models).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_MODEL_FAST=meta-llama/llama-3.3-70b-instruct
# Opcional: modelo de generación de imágenes (salida multimodal).
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# ─── URL base de la app (redirect URIs de OAuth, etc.) ─────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor — NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Redes Sociales (OAuth) ────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Clave para cifrar tokens de OAuth almacenados (AES-256, 32 bytes hex).
TOKEN_ENCRYPTION_KEY=

# Secreto compartido para autenticar el disparador cron.
CRON_SECRET=

# ─── Generación multimedia asíncrona (video / audio) ───────────
# Opcional: proveedor externo que genera en background y notifica al webhook.
MEDIA_VIDEO_PROVIDER_URL=
MEDIA_AUDIO_PROVIDER_URL=
MEDIA_PROVIDER_API_KEY=
# Secreto que firma la URL del webhook /api/generate/webhook.
MEDIA_WEBHOOK_SECRET=
